<UserControl x:Class="CRUD.Modificar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CRUD"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Button Content="X" FontFamily="Inter" FontSize="14" FontWeight="Bold" Foreground="Black" Background="#5DB85B" Width="30" Height="30" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Click="CerrarClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button Content="-" FontFamily="Inter" FontSize="14" FontWeight="Bold" Foreground="Black" Background="#5DB85B" Width="30" Height="30" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,50,0" Click="MinimizarClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <TextBlock Text="MODIFICAR" FontFamily="Inter" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="17" Foreground="#5DB85B" Margin="100,40,0,0" />
        <TextBlock Text="Producto antiguo" Foreground="#5DB85B" FontSize="15" Margin="100,80,0,0" />
        <TextBlock Text="Producto nuevo" Foreground="#5DB85B" FontSize="15" Margin="425,80,-325,0" />
        <TextBox Width="250" Height="30" Background="Transparent" Foreground="White" BorderBrush="#777777" HorizontalAlignment="Left" BorderThickness="0,0,0,1" Margin="100,114,0,306" />
        <TextBox Width="250" Height="30" Background="Transparent" Foreground="White" BorderBrush="#777777" HorizontalAlignment="Left" BorderThickness="0,0,0,1" Margin="425,114,0,306" />
        <TextBlock Text="Categoría" Foreground="#5DB85B" FontSize="15" Margin="100,167,0,23" />
        <ComboBox Width="100" Height="25" Margin="100,210,600,210" />
        <Button Content="Modificar" FontFamily="Inter" FontSize="14" FontWeight="Bold" Foreground="Black" Background="#5DB85B" Width="150" Height="30" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="450,0,0,0" Click="MinimizarClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <TextBlock Text="Productos" Foreground="#5DB85B" FontSize="15" Margin="126,265,-26,-75" />
        <TextBlock Text="Productos" Foreground="#5DB85B" FontSize="15" Margin="450,265,-350,-75" />
    </Grid>
</UserControl>
