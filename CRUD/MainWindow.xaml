<Window x:Class="CRUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUD"
        mc:Ignorable="d"
        Background="#242424"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Text="NORTHWIND" FontFamily="Inter" FontSize="48" FontWeight="Bold" Foreground="#5DB85B"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
            <TextBlock.Effect>
                <DropShadowEffect Color="#5DB85B" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
            </TextBlock.Effect>
        </TextBlock>
        <Image Source="bd.png" Width="60" Height="60" HorizontalAlignment="Right" Margin="0,30,40,0">
            <Image.BitmapEffect>
                <DropShadowBitmapEffect Color="#FFFFFF" ShadowDepth="0" />
            </Image.BitmapEffect>
        </Image>
        <TextBlock Text="Usuario" FontFamily="Inter" FontSize="14" Foreground="#72FF72" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-200,140,0,0" />
        <TextBox Width="250" Height="30" Background="Transparent" Foreground="White" BorderBrush="#777777" BorderThickness="0,0,0,1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,165,0,0" />
        <TextBlock Text="Contraseña" FontFamily="Inter" FontSize="14" Foreground="#72FF72" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-170,210,0,0" />
        <PasswordBox Width="250" Height="30" Background="Transparent" Foreground="White" BorderBrush="#777777" BorderThickness="0,0,0,1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,235,0,0" />
        <Button Content="Entrar" FontFamily="Inter" FontSize="16" FontWeight="Bold" Foreground="Black" Background="#5DB85B" Width="140" Height="35" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,320,0,0" Click="LoginClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button Content="X" FontFamily="Inter" FontSize="14" FontWeight="Bold" Foreground="Black" Background="#5DB85B" Width="30" Height="30" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Click="CerrarClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button Content="-" FontFamily="Inter" FontSize="14" FontWeight="Bold" Foreground="Black" Background="#5DB85B" Width="30" Height="30" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,50,0" Click="MinimizarClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>